# Copiar este archivo a:  .env.smoke-prod-readonly  (esta ruta esta en .gitignore)
# Solo para: npm run smoke:gp-operativa-readonly  (RPC de lectura; no modifica tablas).
#
# No reutilices las claves de .env.test (Pandy-Dev; E2E puede truncar datos).
# La service role debe ser del mismo proyecto Supabase que la URL (p. ej. produccion).
#
# Deja SMOKE_GP_READONLY_CONFIRM=yes abajo; no hace falta export en la terminal si usas este archivo.
#
SMOKE_GP_READONLY_CONFIRM=yes
SMOKE_GP_SUPABASE_URL=https://TU-PROYECTO-PROD.supabase.co
SMOKE_GP_SUPABASE_SERVICE_ROLE_KEY=PEGAR_AQUI_LA_SERVICE_ROLE_DESDE_SUPABASE_SETTINGS_API

# Opcional: acotar período (UTC, YYYY-MM-DD). Por defecto ~400 días hasta hoy.
# SMOKE_GP_DESDE=2024-01-01
# SMOKE_GP_HASTA=2026-04-17

# Opcional: también probar gp_operativa_detalle (bolsa caja_manual)
# SMOKE_GP_INCLUDE_DETALLE=1
