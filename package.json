{
  "name": "pandi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "bitacora": "node scripts/crear-bitacora-excel.js",
    "excel:matriz-cc-reglas": "node scripts/export-matriz-cc-reglas-excel.js",
    "excel:gp-aporte-ordenes": "node scripts/export-gp-operativa-aporte-por-orden-excel.mjs",
    "excel:matriz-clasificacion-gp": "node scripts/crear-matriz-clasificacion-gp-xlsx.js",
    "excel:matriz-clasificacion-trx": "node scripts/crear-matriz-clasificacion-transaccion-xlsx.js",
    "excel:gp-bolsas": "node scripts/export-gp-operativa-detalle-bolsas-excel.mjs",
    "sql:vuelco-inicial": "node scripts/generar-sql-vuelco-inicial.js",
    "dev:supabase:volcar": "node scripts/volcar-pandy-dev-supabase.js",
    "sql:bootstrap:dev": "node scripts/concat-bootstrap-dev-sql.js",
    "sql:seed:reglas-de-negocio": "node scripts/reglas-de-negocio-csv-a-seed-sql.js",
    "sql:seed:tipos-operacion": "node scripts/tipos-operacion-csv-a-seed-sql.js",
    "contingencia:excel": "node scripts/crear-excel-contingencia-ordenes.js",
    "assets:iconos-transparentes": "node scripts/quitar-fondo-blanco-iconos.js",
    "assets:dev-favicon": "node scripts/generate-dev-favicon.js",
    "plan-pwa:docx": "node scripts/crear-plan-pwa-offline-docx.js",
    "build": "node scripts/build-config.js && vite build",
    "build:dev-icon": "PANDI_DEV_ICON=1 node scripts/build-config.js && PANDI_DEV_ICON=1 vite build",
    "dev": "node scripts/build-config.js && vite --port 5173",
    "dev:host": "node scripts/build-config.js && vite --port 5173 --host 0.0.0.0",
    "dev:open": "node scripts/build-config.js && vite --open --port 5173",
    "preview": "node scripts/build-config.js && vite preview",
    "test:unit-cc-flip": "node --test tests/unit/compensacion-cc-flip-logica.test.mjs",
    "test:unit-cc-patron-nueva-regla": "node --test tests/unit/cc-patron-nueva-regla-monr-mone.test.mjs",
    "test:unit-cc-invariante-nueva-regla": "node --test tests/unit/cc-invariante-nueva-regla-neteo.test.mjs",
    "test:unit-clasificacion-gp": "node --test tests/unit/clasificacion-gp-sql-paridad.test.mjs",
    "test:unit-clasificacion": "node --test tests/unit/clasificacion-gp-sql-paridad.test.mjs tests/unit/clasificacion-sync-inferencia.test.mjs",
    "smoke:gp-operativa-readonly": "node scripts/smoke-gp-operativa-readonly.mjs",
    "test:e2e": "playwright test --reporter=line --workers=1",
    "test:e2e:orden": "playwright test --grep-invert \"Reversa\"",
    "test:e2e:reversa": "playwright test -g \"Reversa\"",
    "test:e2e-cc-tipos-2tx": "playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js",
    "test:e2e-cc-usd-ars-sin-int": "TIPO_CODIGO=USD-ARS playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-ars-usd-sin-int": "TIPO_CODIGO=ARS-USD playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-eur-usd-sin-int": "TIPO_CODIGO=EUR-USD playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-usd-eur-sin-int": "TIPO_CODIGO=USD-EUR playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-eur-ars-sin-int": "TIPO_CODIGO=EUR-ARS playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-ars-eur-sin-int": "TIPO_CODIGO=ARS-EUR playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-usd-usd-sin-int": "TIPO_CODIGO=USD-USD playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-usd-usd-int-combos": "TIPO_CODIGO=USD-USD TIPO_USA_INTERMEDIARIO=true playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-usd-usd-int": "playwright test tests/e2e/91-orden-cc.spec.js -g \"crear orden USD-USD con intermediario\" --reporter=line --workers=1",
    "test:e2e-cc-usd-ars-int-inversa": "TIPO_CODIGO=USD-ARS playwright test tests/e2e/03-cc-intermediario-inversa-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-ars-usd-int-inversa": "TIPO_CODIGO=ARS-USD playwright test tests/e2e/03-cc-intermediario-inversa-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-usd-eur-int-inversa": "TIPO_CODIGO=USD-EUR playwright test tests/e2e/03-cc-intermediario-inversa-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-eur-usd-int-inversa": "TIPO_CODIGO=EUR-USD playwright test tests/e2e/03-cc-intermediario-inversa-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-eur-ars-int-inversa": "TIPO_CODIGO=EUR-ARS playwright test tests/e2e/03-cc-intermediario-inversa-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-ars-eur-int-inversa": "TIPO_CODIGO=ARS-EUR playwright test tests/e2e/03-cc-intermediario-inversa-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-02-03": "playwright test tests/e2e/02-cc-tipos-activos-combinaciones.spec.js tests/e2e/03-cc-intermediario-inversa-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-cheque-ars": "playwright test tests/e2e/01-cc-combinaciones.spec.js --reporter=line --workers=1",
    "test:e2e-cc-cheque-comision-invariante": "playwright test tests/e2e/92-cheque-ars-comision-acuerdo-invariante.spec.js --reporter=line --workers=1",
    "test:e2e-cc-activos-completo": "playwright test tests/e2e/01-cc-combinaciones.spec.js tests/e2e/02-cc-tipos-activos-combinaciones.spec.js tests/e2e/03-cc-intermediario-inversa-combinaciones.spec.js --reporter=line --workers=1",
    "playwright:install": "playwright install chromium",
    "lighthouse": "node scripts/lighthouse-pandi.js",
    "lighthouse:mobile": "node scripts/lighthouse-pandi.js --mobile",
    "docs:pdf:instalar-movil": "node scripts/generar-pdf-instalacion-movil.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@supabase/supabase-js": "^2.45.0",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "lighthouse": "^12.8.2",
    "playwright": "^1.49.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
