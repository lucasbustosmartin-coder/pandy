# Copiar a la raíz del repo:
#   cp .env.example .env
# y completar con tu proyecto Supabase de DESARROLLO (Dashboard → Settings → API).
# No subas .env ni .env.local a Git (.gitignore).
#
# Prioridad: si existe .env.local, sus valores pisan los de .env.
# No pongas en .env.local SUPABASE_* copiados de Vercel/producción: dejan la app local en prod por error.

SUPABASE_URL=https://TU-REF-DESARROLLO.supabase.co
SUPABASE_ANON_KEY=

# Opcional: scripts Node (E2E limpieza, volcar Excel). No la pongas en Vercel Production.
# SUPABASE_SERVICE_ROLE_KEY=

# Opcional: iconos/favicon tema “dev” (celeste), alineado a Preview Vercel — afecta build-config y vite.config (PWA).
# PANDI_DEV_ICON=1
