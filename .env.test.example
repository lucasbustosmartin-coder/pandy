# Copiar a .env.test y completar. No subir .env.test al repositorio.
# TEST_BASE_URL: debe coincidir con el puerto donde corre la app. Por defecto dev usa --port 5173.
# TEST_USER_EMAIL: email del usuario con el que los tests hacen login
# TEST_USER_PASSWORD: contraseña de ese usuario
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY: para limpiar base antes de E2E (scripts/limpiar-base-e2e.js).
#   Si no están, la limpieza se omite y los tests corren igual (útil si ya truncaste a mano).

TEST_BASE_URL=http://localhost:5173
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
